@startuml C2_Transition_State_v9
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title GoFuture — C2 Transition State with ACL (месяцы 1–11)

skinparam defaultFontColor #000000
skinparam ArrowFontColor #333333
skinparam ArrowColor #555555

AddElementTag("new",    $bgColor="#C8E6C9", $borderColor="#2E7D32", $fontColor="#1B5E20")
AddElementTag("legacy", $bgColor="#FFCDD2", $borderColor="#C62828", $fontColor="#B71C1C")
AddElementTag("acl",    $bgColor="#FFE0B2", $borderColor="#E65100", $fontColor="#BF360C")

' === ACTORS ===
Person(passenger, "Пассажир", "Заказывает поездки, отслеживает водителя на карте, оплачивает, оценивает поездку")
Person(driver, "Водитель", "Принимает заказы, выполняет поездки, управляет статусом, получает выплаты")
Person(manager, "Корпоративный менеджер", "Управляет корпоративными поездками сотрудников, счетами и лимитами")
Person(accountant, "Бухгалтер", "Контролирует выплаты водителям и финансовую отчётность")

System_Boundary(gofuture, "GoFuture Platform") {

    System_Boundary(clients, "Client Apps") {
        Container(old_passenger_app, "Старое пассажирское приложение", "Mobile (native)", "Старые версии мобильного приложения пассажира. v1 API, session-аутентификация. Работают без изменений весь период миграции", $tags="legacy")
        Container(old_driver_app, "Старое водительское приложение", "Mobile (native)", "Старые версии мобильного приложения водителя. v1 API, session-аутентификация", $tags="legacy")
        Container(old_web_portal, "Корпоративный портал (текущий)", "React SPA", "Текущий корпоративный веб-портал. v1 API, DRF Token", $tags="legacy")
        Container(new_web_frontend, "Новый веб-фронтенд", "React + OIDC", "Новый фронтенд для внешних пользователей. v2 API (ACL), OIDC через Keycloak", $tags="new")
        Container(new_passenger_app, "Новое пассажирское приложение", "Mobile + OIDC", "Новая версия мобильного приложения пассажира. Работает через BFF Passenger", $tags="new")
        Container(new_driver_app, "Новое водительское приложение", "Mobile + OIDC", "Новая версия мобильного приложения водителя. Работает через BFF Driver", $tags="new")
        Container(new_corp_portal, "Новый корпоративный портал", "React + OIDC", "Новый корпоративный портал через BFF Corporate", $tags="new")
        Container(new_admin_panel, "Новая админ-панель", "React + OIDC", "Новая админ-панель через BFF Admin", $tags="new")
    }

    System_Boundary(edge, "Edge Layer") {
        Container(gateway, "API Gateway", "Kong", "Маршрутизация: /v1/* → Monolith Legacy; /v2/* → Monolith ACL; /bff/* → BFF-сервисы. Rate limiting, аутентификация на edge, канареечные релизы")
        Container(bff_passenger, "BFF Passenger", "Python (FastAPI)", "Для новых мобильных пассажиров. Агрегирует Booking, Pricing, Geography, Payments", $tags="new")
        Container(bff_driver, "BFF Driver", "Python (FastAPI)", "Для новых мобильных водителей. Агрегирует Driver Profile, Driver Status, Booking, Payouts", $tags="new")
        Container(bff_corp, "BFF Corporate", "Python (FastAPI)", "Для нового корпоративного портала. Агрегирует Booking, Payments, Analytics", $tags="new")
        Container(bff_admin, "BFF Admin", "Python (FastAPI)", "Для админ-панели. Агрегирует Tenant, Identity, Payouts, Fraud", $tags="new")
    }

    System_Boundary(monolith, "Django Monolith (shrinking)") {
        Container(legacy_api, "Legacy API v1", "Django + Session/DRF Token", "Обслуживает старых клиентов. Legacy-логика доменов, ещё не вынесенных. Сжимается по мере миграции", $tags="legacy")
        Container(acl, "Anti-Corruption Layer", "Django app (acl/)", "v2 Controllers (OIDC), Routing по feature flags, Model Translators (Domain ↔ DTO), HTTP Clients к сервисам, Kafka Producer через outbox. Никакой бизнес-логики", $tags="acl")
        ContainerDb(db_main, "Main DB + Outbox", "PostgreSQL", "Бизнес-данные монолита + таблица outbox для транзакционной публикации в Kafka (at-least-once). Poller в app_worker читает outbox", $tags="legacy")
        Container(app_worker, "Celery Workers (shrinking)", "Celery", "Оставшиеся задачи: payout_tasks, analytics_tasks. notification_tasks вынесен. Сжимается и удаляется по мере миграции", $tags="legacy")
    }

    System_Boundary(business, "Business Services (extracted)") {
        Container(svc_booking, "Booking", "Python (FastAPI)", "Жизненный цикл поездки. Публикует BookingCreated, BookingCompleted", $tags="new")
        Container(svc_driver_profile, "Driver Profile", "Python (FastAPI)", "Аккаунт, документы, KYC, рейтинг. Foundation для Booking и Payouts", $tags="new")
        Container(svc_driver_status, "Driver Status", "Python (FastAPI)", "Статус, геопозиция, занятость. Подписан на BookingCreated и DriverLocationUpdated", $tags="new")
        Container(svc_pricing, "Pricing", "Python (FastAPI)", "Тарифы и динамическое ценообразование. Подписан на BookingCreated", $tags="new")
        Container(svc_payments, "Payments", "Python (FastAPI)", "Приём платежей, Яндекс Пэй. Публикует PaymentSucceeded / Failed", $tags="new")
        Container(svc_payouts, "Payouts", "Python (FastAPI)", "Расчёт заработка, батчевые выплаты. Подписан на PaymentSucceeded", $tags="new")
        Container(svc_notification, "Notification", "Python (FastAPI)", "Push, SMS, email. Подписан на все доменные события. Первый вынесенный сервис (Wave 1)", $tags="new")
        Container(svc_geography, "Geography", "Python (FastAPI)", "Геопоиск, маршруты, зоны. Foundation для Booking, Pricing, Driver Status", $tags="new")
        Container(svc_analytics, "Analytics", "Python (FastAPI)", "Операционная аналитика. Подписан на все доменные события", $tags="new")
        Container(svc_fraud, "Fraud", "Python (FastAPI)", "Скоринг, ML-детекция. Публикует FraudAlert", $tags="new")
    }

    System_Boundary(platform, "Platform Services") {
        Container(keycloak, "Keycloak", "OIDC Provider", "Единый OIDC-провайдер для v2-клиентов и новых сервисов. Монолит v1 продолжает со своей auth", $tags="new")
        Container(svc_identity, "Identity Service", "Python + Keycloak adapter", "Управление пользователями, ролями, сессиями. Adapter к Keycloak", $tags="new")
        Container(svc_tenant, "Tenant Management", "Python (FastAPI)", "Управление партнёрами/тенантами. Foundation для мультитенантности", $tags="new")
        Container(ff, "Feature Flags", "Unleash / LaunchDarkly", "Централизованное управление флагами: v1/v2 routing, shadow/dual режимы, rollout %, kill switch")
    }

    ContainerQueue(kafka, "Event Bus", "Apache Kafka + Schema Registry", "Шина доменных событий. Schema Registry для эволюции контрактов")

    System_Boundary(stores, "Data Stores (per service)") {
        ContainerDb(db_booking, "Booking DB", "PostgreSQL", "Поездки, статусы", $tags="new")
        ContainerDb(db_driver_profile, "Driver Profile DB", "PostgreSQL", "Аккаунты, документы, KYC", $tags="new")
        ContainerDb(db_driver_status, "Driver Status Store", "Redis + PostGIS", "Статусы, геопозиции, геоиндексы", $tags="new")
        ContainerDb(db_pricing, "Pricing Store", "PostgreSQL + Redis", "Тарифы, кеш цен", $tags="new")
        ContainerDb(db_payments, "Payments DB", "PostgreSQL", "Платежи, транзакции", $tags="new")
        ContainerDb(db_payouts, "Payouts DB", "PostgreSQL", "Заработок, батчи", $tags="new")
        ContainerDb(db_notification, "Notification DB", "PostgreSQL", "Шаблоны, device tokens, логи", $tags="new")
        ContainerDb(db_geography, "Geography Store", "PostGIS / Elasticsearch", "Зоны, маршруты, геоиндексы", $tags="new")
        ContainerDb(db_analytics, "Analytics DB", "PostgreSQL", "Агрегированные метрики", $tags="new")
        ContainerDb(db_fraud, "Fraud DB", "PostgreSQL", "Правила, скоры", $tags="new")
        ContainerDb(db_identity, "Identity DB", "PostgreSQL", "Пользователи, роли, сессии", $tags="new")
        ContainerDb(db_tenant, "Tenant DB", "PostgreSQL", "Тенанты, конфигурация", $tags="new")
    }

    System_Boundary(observability, "Observability") {
        Container(otel, "OTel Collector", "OpenTelemetry Collector", "Приём traces, metrics, logs от всех сервисов и монолита")
        Container(prometheus, "Prometheus", "Metrics Store", "Хранение метрик, оценка правил алертинга")
        Container(loki, "Loki", "Log Aggregation", "Централизованное хранение логов")
        Container(grafana, "Grafana", "Dashboards", "Визуализация, SLO-дашборды")
        Container(alertmanager, "Alertmanager", "Alerting", "Маршрутизация алертов")
    }

    System_Boundary(cicd, "CI/CD") {
        Container(gitlab, "GitLab CI", "CI/CD Server", "Сборка, тесты, деплой монолита и сервисов")
        Container(registry, "Docker Registry", "Container Registry", "Хранение Docker-образов")
    }

    System_Boundary(data_platform, "Data Platform / ML") {
        Container(spark, "Stream / Batch Processing", "Spark / Flink", "Обработка событий из Kafka для DWH", $tags="new")
        Container(clickhouse, "Data Warehouse", "ClickHouse", "Колоночное хранилище для BI и ML", $tags="new")
        Container(ml, "ML Platform", "MLflow / Kubeflow", "Обучение и serving ML-моделей", $tags="new")
        Container(bi, "BI Tools", "DataLens", "Дашборды и отчёты", $tags="new")
    }
}

System_Ext(push_providers, "Push-провайдеры (FCM / APNs / Huawei)", "Доставка push-уведомлений")
System_Ext(yandex_pay, "Яндекс Пэй", "Платёжный шлюз")
System_Ext(yandex_maps, "Яндекс Карты", "Картографический сервис")
System_Ext(bank_api, "Bank API", "Банковские выплаты")

' === ACTORS → APPS ===
Rel(passenger, old_passenger_app, "Заказывает (старая версия)")
Rel(driver, old_driver_app, "Работает (старая версия)")
Rel(manager, old_web_portal, "Управляет счетами (текущий)")
Rel(accountant, old_web_portal, "Контролирует выплаты (текущий)")
Rel(passenger, new_passenger_app, "Заказывает (новая версия)", "OIDC")
Rel(driver, new_driver_app, "Работает (новая версия)", "OIDC")
Rel(manager, new_corp_portal, "Управляет счетами (новый)", "OIDC")
Rel(accountant, new_admin_panel, "Контролирует выплаты (админка)", "OIDC")
Rel(passenger, new_web_frontend, "Заказывает через веб", "OIDC")

' === APPS → KONG ===
Rel(old_passenger_app, gateway, "v1 API", "HTTPS / Session")
Rel(old_driver_app, gateway, "v1 API", "HTTPS / Session")
Rel(old_web_portal, gateway, "v1 API", "HTTPS / DRF Token")
Rel(new_web_frontend, gateway, "v2 API", "HTTPS / OIDC")
Rel(new_passenger_app, gateway, "BFF Passenger", "HTTPS / OIDC")
Rel(new_driver_app, gateway, "BFF Driver", "HTTPS / OIDC")
Rel(new_corp_portal, gateway, "BFF Corporate", "HTTPS / OIDC")
Rel(new_admin_panel, gateway, "BFF Admin", "HTTPS / OIDC")

' === KONG → DESTINATIONS ===
Rel(gateway, legacy_api, "/api/v1/*", "REST")
Rel(gateway, acl, "/api/v2/*", "REST")
Rel(gateway, bff_passenger, "/api/bff/passenger/*", "REST")
Rel(gateway, bff_driver, "/api/bff/driver/*", "REST")
Rel(gateway, bff_corp, "/api/bff/corp/*", "REST")
Rel(gateway, bff_admin, "/api/bff/admin/*", "REST")

' === BFF → SERVICES ===
Rel(bff_passenger, svc_booking, "Создание / отмена", "REST")
Rel(bff_passenger, svc_pricing, "Цена", "REST")
Rel(bff_passenger, svc_geography, "Адрес / маршрут", "REST")
Rel(bff_passenger, svc_payments, "Платёж", "REST")

Rel(bff_driver, svc_driver_profile, "Профиль", "REST")
Rel(bff_driver, svc_driver_status, "Статус / геопозиция", "REST")
Rel(bff_driver, svc_booking, "Принятие / завершение", "REST")
Rel(bff_driver, svc_payouts, "Заработок", "REST")

Rel(bff_corp, svc_booking, "Корп. поездки", "REST")
Rel(bff_corp, svc_payments, "Счета", "REST")
Rel(bff_corp, svc_analytics, "Отчёты", "REST")

Rel(bff_admin, svc_tenant, "Тенанты", "REST")
Rel(bff_admin, svc_identity, "Пользователи", "REST")
Rel(bff_admin, svc_payouts, "Выплаты", "REST")
Rel(bff_admin, svc_fraud, "Правила fraud", "REST")

' === MONOLITH INTERNALS ===
Rel(legacy_api, db_main, "R/W бизнес-данных", "SQL / ORM")
Rel(legacy_api, acl, "Вызовы вынесенных сервисов", "internal API")
Rel(acl, db_main, "R/W + Outbox (одна транзакция)", "SQL / ORM")
Rel(acl, keycloak, "Валидация JWT v2", "OIDC / JWKS")
Rel(acl, ff, "Чтение feature flags", "REST")
Rel(app_worker, db_main, "R/W фоновых задач", "ORM")

' === ACL → KAFKA ===
Rel(acl, kafka, "Publish через outbox: NotificationRequested, DriverLocationUpdated, BookingCreated и др.", "Kafka")

' === ACL → SERVICES (sync) ===
Rel(acl, svc_pricing, "Sync: расчёт цены", "REST")
Rel(acl, svc_geography, "Sync: гео", "REST")
Rel(acl, svc_booking, "Sync: создание поездки (Wave 6)", "REST")
Rel(acl, svc_payments, "Sync: платёж", "REST")
Rel(acl, svc_payouts, "Sync: выплата", "REST")
Rel(acl, svc_driver_status, "Sync: статус", "REST")
Rel(acl, svc_driver_profile, "Sync: профиль", "REST")
Rel(acl, svc_fraud, "Sync: fraud check", "REST")

' === CELERY → KAFKA ===
Rel(app_worker, kafka, "Publish: PayoutCompleted, analytics events", "Kafka")

' === KAFKA → SERVICES ===
Rel(kafka, svc_notification, "Subscribe: все доменные события", "Kafka")
Rel(kafka, svc_analytics, "Subscribe: все доменные события", "Kafka")
Rel(kafka, svc_fraud, "Subscribe: платежи и поездки", "Kafka")
Rel(kafka, svc_payouts, "Subscribe: PaymentSucceeded", "Kafka")
Rel(kafka, svc_driver_status, "Subscribe: BookingCreated, DriverLocationUpdated", "Kafka")
Rel(kafka, svc_pricing, "Subscribe: BookingCreated", "Kafka")

' === EXTERNAL ===
Rel(svc_notification, push_providers, "Push iOS / Android / Huawei", "REST / HTTPS")
Rel(svc_payments, yandex_pay, "Платёж, возврат", "REST / HTTPS")
Rel(svc_payouts, bank_api, "Выплата", "REST / HTTPS")
Rel(svc_geography, yandex_maps, "Геоданные", "REST / HTTPS")

' === SERVICES → OWN DB ===
Rel(svc_booking, db_booking, "R/W", "SQL / ORM")
Rel(svc_driver_profile, db_driver_profile, "R/W", "SQL / ORM")
Rel(svc_driver_status, db_driver_status, "R/W", "Redis / PostGIS")
Rel(svc_pricing, db_pricing, "R/W", "SQL / Redis")
Rel(svc_payments, db_payments, "R/W", "SQL / ORM")
Rel(svc_payouts, db_payouts, "R/W", "SQL / ORM")
Rel(svc_notification, db_notification, "R/W", "SQL / ORM")
Rel(svc_geography, db_geography, "R/W", "PostGIS / ES")
Rel(svc_analytics, db_analytics, "R/W", "SQL / ORM")
Rel(svc_fraud, db_fraud, "R/W", "SQL / ORM")
Rel(svc_identity, db_identity, "R/W", "SQL / ORM")
Rel(svc_tenant, db_tenant, "R/W", "SQL / ORM")

' === OBSERVABILITY ===
Rel(business, otel, "Traces / Metrics / Logs от всех бизнес-сервисов", "OTLP")
Rel(monolith, otel, "Traces / Metrics / Logs от монолита", "OTLP")
Rel(otel, prometheus, "Метрики", "Remote Write")
Rel(otel, loki, "Логи", "Loki Push API")
Rel(prometheus, grafana, "Данные для дашбордов", "PromQL")
Rel(loki, grafana, "Логи для дашбордов", "LogQL")
Rel(prometheus, alertmanager, "Алерты", "Webhook")

' === CI/CD ===
Rel(gitlab, registry, "Публикация образов", "Docker Push")

' === DATA PLATFORM ===
Rel(kafka, spark, "Поток событий", "Kafka Consumer")
Rel(spark, clickhouse, "Запись агрегатов", "JDBC")
Rel(clickhouse, ml, "Данные для обучения", "SQL")
Rel(clickhouse, bi, "Данные для отчётов", "SQL")

' === IDENTITY ===
Rel(svc_identity, keycloak, "Управление пользователями", "Admin API")
Rel(bff_passenger, keycloak, "Валидация JWT", "OIDC")
Rel(bff_driver, keycloak, "Валидация JWT", "OIDC")
Rel(bff_corp, keycloak, "Валидация JWT", "OIDC")
Rel(bff_admin, keycloak, "Валидация JWT", "OIDC")

' === FEATURE FLAGS ===
Rel(bff_passenger, ff, "Чтение флагов", "REST")
Rel(bff_driver, ff, "Чтение флагов", "REST")
Rel(bff_corp, ff, "Чтение флагов", "REST")
Rel(bff_admin, ff, "Чтение флагов", "REST")

Rel(ml, svc_pricing, "Деплой ML-модели прогнозирования спроса", "Model Registry")
Rel(ml, svc_fraud, "Деплой ML-модели детекции фрода", "Model Registry")

legend right
  |= Цвет |= Значение |
  |<#C8E6C9> Новое (To-Be) | Новые сервисы, клиенты на OIDC, Keycloak — остаются в Final State |
  |<#FFCDD2> Legacy | Монолит, старые клиенты на v1, Celery — удаляются по мере миграции |
  |<#FFE0B2> ACL | Anti-Corruption Layer — временный слой, удаляется после миграции |
endlegend

@enduml