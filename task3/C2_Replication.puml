        System_Ext(sea_bank, "DBS / OCBC", "Выплаты водителям SEA", $tags="new")
    }
}

Rel(sea_edge_chain, sea_platform, "Ingress (health-checked)", "HTTPS")

Rel(sea_platform, sea_nonpii,  "Non-PII replication only (outbox, aggregates, configs, schemas, models)", "HTTPS / S3")
Rel(sea_ch,       sea_ch_rep,  "Aggregates backup", "S3")
Rel(sea_platform, sea_obj_rep, "Non-PII object replication", "S3")
Rel(sea_platform, sea_failover, "Health check", "HTTPS")
Rel(sea_failover, sea_nonpii,  "Restore non-PII", "HTTPS")
Rel(sea_failover, sea_edge_chain, "DNS switch (partial DR)", "API")

Rel(sea_platform, apicurio_sync, "Pull schemas on start", "HTTPS")
Rel(sea_platform, unleash_fed,   "Pull flags", "HTTPS")
Rel(sea_platform, fraud_sync,    "Pull fraud rules", "HTTPS")
Rel(sea_platform, tenant_sync,   "Pull tenant configs", "HTTPS")
Rel(sea_platform, identity_dir,  "Resolve home_region (roaming)", "HTTPS")
Rel(sea_platform, vault,         "Secrets sync", "HTTPS")

Rel(sea_ch, global_ch, "Aggregates (hashed, non-PII)", "Batch / S3")
Rel(ml_train, sea_platform, "Deploy model artifact", "HTTPS / S3")

Rel(sea_platform, sea_pay,  "Платежи", "HTTPS")
Rel(sea_platform, sea_maps, "Геокодирование", "HTTPS")
Rel(sea_platform, sea_bank, "Выплаты", "HTTPS")

