@startuml C2_Replication
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title GoFuture — C2 Replication (Task3). Красным — новое, синим — из Task1/Task2

skinparam defaultFontColor #000000
skinparam ArrowFontColor #333333
skinparam ArrowColor #555555

AddElementTag("new",      $bgColor="#FFEBEE", $borderColor="#C62828", $fontColor="#B71C1C")
AddElementTag("existing", $bgColor="#E3F2FD", $borderColor="#1565C0", $fontColor="#0D47A1")
AddElementTag("global",   $bgColor="#FFF3E0", $borderColor="#E65100", $fontColor="#BF360C")
AddElementTag("dr",       $bgColor="#F3E5F5", $borderColor="#6A1B9A", $fontColor="#4A148C")

' ============================================================
' GLOBAL LAYER
' ============================================================
System_Boundary(global_cp, "Global Control Plane (единое состояние во всех регионах)") {
    Container(apicurio_sync, "Apicurio Sync", "Schema Registry Federation", "Avro-схемы 20 событий. Pull-on-start + webhook", $tags="global")
    Container(unleash_fed,   "Unleash Federation", "Feature Flags", "Canary / kill-switch. Единое состояние", $tags="global")
    Container(fraud_sync,    "Fraud Rules Sync", "Rules Distribution", "Правила fraud (не скоры). Глобальный ассет", $tags="global")
    Container(tenant_sync,   "Tenant Config Sync", "Config Service", "Корп-клиенты, квоты, лимиты", $tags="global")
    Container(identity_dir,  "Global Identity Directory", "user_id -> home_region", "Только маршрутизация, без PII", $tags="global")
    Container(vault,         "Vault", "Secrets Management", "JWT keys, encryption keys. Sync между регионами", $tags="global")
}

System_Boundary(global_analytics, "Global Analytics (non-PII only)") {
    ContainerDb(global_ch, "Global ClickHouse", "Data Warehouse", "Агрегаты из регионов (хэшированные)", $tags="global")
    Container(ml_train,    "ML Training Cluster", "MLflow / Kubeflow", "Обучение на агрегатах. Деплой в регионы", $tags="global")
    Container(bi,          "Global BI", "DataLens", "Инвесторские и корп-отчёты", $tags="global")
}

Rel(global_ch, ml_train, "Данные для обучения", "SQL")
Rel(global_ch, bi,       "Агрегаты для отчётов", "SQL")

' ============================================================
' REGION RU
' ============================================================
System_Boundary(region_ru, "region-ru (152-ФЗ) — PII только в РФ") {

    System_Boundary(ru_edge, "Regional Edge & Security — зона 1") {
        Container(ru_edge_chain, "DNS -> WAF -> DDoS -> Firewall -> GLB", "Cloudflare + Network Firewall + L7 GLB", "GeoDNS, OWASP Top-10, L3-L7 AntiDDoS, mTLS, health-checked ingress", $tags="new")
    }

    System_Boundary(ru_z1, "GoFuture Platform — зона 1 (Москва, TIER IV)") {
        Container(ru_platform, "GoFuture Platform", "C2 Final из Task2", "BFF, 10 сервисов, БД, Kafka, Flink, ML, ClickHouse, Observability", $tags="existing")
        ContainerDb(ru_pg, "PostgreSQL (primary)", "Transactional DBs", "Booking, Payments, Payouts, Driver, Identity, Tenant", $tags="existing")
        Container(ru_kafka, "Kafka Cluster (изолированный)", "180 топиков", "36 events + 36 DLQ + 108 retry. RF=3, acks=all", $tags="existing")
        ContainerDb(ru_ch, "ClickHouse (regional)", "Analytics", "Региональные агрегаты", $tags="existing")
    }

    System_Boundary(ru_z2, "GoFuture Platform — зона 2 (СПб, DR)") {
        ContainerDb(ru_pg_rep,       "PostgreSQL (replica)", "Streaming replica", "Async replication, RPO <= 15 мин (финансы)", $tags="dr")
        Container(ru_keycloak_rep,   "Keycloak (replica)", "OIDC", "Read-replica + backup", $tags="dr")
        ContainerDb(ru_ch_rep,       "ClickHouse (backup)", "Backup", "Backup + restore", $tags="dr")
        Container(ru_obj_rep,        "Object Storage (replica)", "S3-compatible", "KYC, media. Cross-city replication", $tags="dr")
        Container(ru_failover,       "Failover Orchestrator", "Automation", "Health -> promote replica -> DNS switch. RTO <= 45 мин", $tags="new")
    }

    System_Boundary(ru_ext, "Regional Externals (RU)") {
        System_Ext(ru_pay,  "Yandex Pay", "Платёжный шлюз RU", $tags="existing")
        System_Ext(ru_maps, "Yandex Maps", "Карты RU", $tags="existing")
        System_Ext(ru_bank, "Bank API (RU)", "Выплаты водителям", $tags="existing")
    }
}

Rel(ru_edge_chain, ru_platform, "Ingress (health-checked)", "HTTPS")

Rel(ru_pg,            ru_pg_rep,       "Streaming replication (async)", "PostgreSQL protocol")
Rel(ru_platform,      ru_keycloak_rep, "Keycloak realm sync", "HTTPS")
Rel(ru_ch,            ru_ch_rep,       "Backup / restore", "S3")
Rel(ru_platform,      ru_obj_rep,      "Object replication (KYC, media)", "S3")
Rel(ru_pg,            ru_failover,     "Health check", "SQL")
Rel(ru_failover,      ru_pg_rep,       "Promote replica", "SQL")
Rel(ru_failover,      ru_edge_chain,   "DNS switch (failover)", "API")

Rel(ru_platform, apicurio_sync, "Pull schemas on start", "HTTPS")
Rel(ru_platform, unleash_fed,   "Pull flags", "HTTPS")
Rel(ru_platform, fraud_sync,    "Pull fraud rules", "HTTPS")
Rel(ru_platform, tenant_sync,   "Pull tenant configs", "HTTPS")
Rel(ru_platform, identity_dir,  "Resolve home_region (roaming)", "HTTPS")
Rel(ru_platform, vault,         "Secrets sync", "HTTPS")

Rel(ru_ch, global_ch, "Aggregates (hashed, non-PII)", "Batch / S3")
Rel(ml_train, ru_platform, "Deploy model artifact", "HTTPS / S3")

Rel(ru_platform, ru_pay,  "Платежи", "HTTPS")
Rel(ru_platform, ru_maps, "Геокодирование", "HTTPS")
Rel(ru_platform, ru_bank, "Выплаты", "HTTPS")

